#!/usr/bin/env python3
"""The `claude` the driver launches per issue, for the tests.

It records every invocation to $FAKE_CLAUDE_LOG (and the branch it ran on to
$FAKE_CLAUDE_LOG.branch), so a test can assert on the command line the driver
built -- which model, and whether the conversation was continued -- and it acts out $FAKE_CLAUDE_PLAN, a JSON list of outcomes consumed
one per invocation:

  done     implement the issue: commit, and mark it done
  touch    commit something but never mark the issue done (a session that died
           mid-task, which is what the driver's retries exist for)
  nothing  change nothing at all and exit
  block    declare a real blocker, which stops the run without retries

Anything past the end of the plan is "done".
"""
import json
import os
import re
import subprocess
import sys

argv = sys.argv[1:]
with open(os.environ["FAKE_CLAUDE_LOG"], "a") as fh:
    fh.write(json.dumps(argv) + "\n")
# ...and the branch each one ran on, one per line next to the command lines,
# so a test can tell where the driver had the tree at that moment.
with open(os.environ["FAKE_CLAUDE_LOG"] + ".branch", "a") as fh:
    fh.write(subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                            capture_output=True, text=True).stdout)

prompt = argv[argv.index("-p") + 1] if "-p" in argv else ""
found = (re.search(r"/issue-pilot:one (\S+)", prompt)
        or re.search(r"#(\d+)", prompt)
        or re.search(r"\b(fix-\d+)\b", prompt))
issue = found.group(1) if found else None

plan = json.loads(os.environ.get("FAKE_CLAUDE_PLAN", "[]"))
counter = os.environ["FAKE_CLAUDE_COUNTER"]
seen = int(open(counter).read() or 0) if os.path.exists(counter) else 0
open(counter, "w").write(str(seen + 1))
action = plan[seen] if seen < len(plan) else "done"

state = os.environ["FAKE_CLAUDE_STATE"]


def run(*cmd):
    subprocess.run(cmd, check=True, capture_output=True)


if issue and action in ("done", "touch"):
    # Appending, so a second attempt on the same issue still has something to
    # commit -- an empty commit would fail and look like a stub bug.
    with open("item-%s.txt" % issue, "a") as fh:
        fh.write("work for %s (invocation %d)\n" % (issue, seen))
    run("git", "add", "-A")
    run("git", "commit", "-qm", "implement %s" % issue)

if issue and action == "done":
    head = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True,
                          text=True).stdout.strip()
    run(sys.executable, state, "done", issue, "--commit", head)

if issue and action == "block":
    run(sys.executable, state, "block", issue, "--reason", "staged blocker")

sys.exit(0)
