#!/usr/bin/env python3
"""A GitHub CLI that answers from a file, for the tests.

`gh pr create` and `gh pr merge` are recorded in $FAKE_GH_PR_LOG (JSON lines) and
the merge is done with git inside the bare origin of the current repository.

`gh issue view <n>` is served from $FAKE_GH_ISSUES, a JSON object mapping issue
number to payload.  Anything not faked is an error, loudly, so a test that
reaches for an unexpected call fails instead of silently passing.
"""
import json
import os
import subprocess
import sys

argv = sys.argv[1:]

if argv[:2] == ["issue", "view"]:
    issues = json.load(open(os.environ["FAKE_GH_ISSUES"]))
    number = argv[2]
    if number not in issues:
        sys.stderr.write("no such issue: %s\n" % number)
        sys.exit(1)
    print(json.dumps(issues[number]))
    sys.exit(0)

if argv[:2] == ["repo", "view"]:
    print(os.environ.get("FAKE_GH_DEFAULT_BRANCH", "main"))
    sys.exit(0)

def option(name):
    return argv[argv.index(name) + 1] if name in argv else None


def pr_log():
    path = os.environ.get("FAKE_GH_PR_LOG")
    if not path:
        sys.stderr.write("fake gh: FAKE_GH_PR_LOG is not set\n")
        sys.exit(2)
    return path


def git(*args):
    return subprocess.run(("git",) + args, capture_output=True, text=True,
                          check=True).stdout.strip()


if argv[:2] == ["pr", "create"]:
    path = pr_log()
    entries = [json.loads(line) for line in open(path)] if os.path.exists(path) else []
    url = "https://github.com/example/repo/pull/%d" % (len(entries) + 1)
    # Like the real thing, the head is the branch that is checked out.
    body_file = option("--body-file")
    entries.append({"args": argv[2:], "head": git("rev-parse", "--abbrev-ref", "HEAD"),
                    "body": open(body_file).read() if body_file else None,
                    "base": option("--base"), "url": url})
    with open(path, "w") as out:
        out.write("".join(json.dumps(e) + "\n" for e in entries))
    print(url)
    sys.exit(0)

if argv[:2] == ["pr", "merge"]:
    if os.environ.get("FAKE_GH_MERGE_REFUSED"):
        sys.stderr.write("pull request is not mergeable\n")
        sys.exit(1)
    entry = [json.loads(line) for line in open(pr_log())
             if json.loads(line)["url"] == argv[2]][0]
    origin = git("remote", "get-url", "origin")
    sha = git("-C", origin, "rev-parse", "refs/heads/" + entry["head"])
    git("-C", origin, "update-ref", "refs/heads/" + entry["base"], sha)
    if "--delete-branch" in argv:
        git("-C", origin, "update-ref", "-d", "refs/heads/" + entry["head"])
    sys.exit(0)

if argv[:1] == ["auth"]:
    sys.exit(0)

sys.stderr.write("fake gh: unexpected call: %s\n" % " ".join(argv))
sys.exit(2)
