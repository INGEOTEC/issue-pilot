#!/usr/bin/env python3
"""A GitHub CLI that answers from a file, for the tests.

`gh issue view <n>` is served from $FAKE_GH_ISSUES, a JSON object mapping issue
number to payload.  Anything not faked is an error, loudly, so a test that
reaches for an unexpected call fails instead of silently passing.
"""
import json
import os
import sys

argv = sys.argv[1:]

if argv[:2] == ["issue", "view"]:
    issues = json.load(open(os.environ["FAKE_GH_ISSUES"]))
    number = argv[2]
    if number not in issues:
        sys.stderr.write("no such issue: %s\n" % number)
        sys.exit(1)
    print(json.dumps(issues[number]))
    sys.exit(0)

if argv[:2] == ["repo", "view"]:
    print(os.environ.get("FAKE_GH_DEFAULT_BRANCH", "main"))
    sys.exit(0)

if argv[:1] == ["auth"]:
    sys.exit(0)

sys.stderr.write("fake gh: unexpected call: %s\n" % " ".join(argv))
sys.exit(2)
